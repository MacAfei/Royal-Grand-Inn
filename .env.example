# AI Hotel Receptionist Configuration

# LLM Provider selection: 'gemini' or 'openai'
# If left blank, it will automatically select based on keys provided.
LLM_PROVIDER=gemini

# Gemini API Key (Get a free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (Optional, if you prefer OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Server Port
PORT=5000
